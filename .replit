modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PYTHONUNBUFFERED = "1"

[deployment]
# "gce" = Reserved VM: nyala terus 24/7. WAJIB pakai ini (bukan "autoscale"),
# karena bot Discord connect ke gateway terus-menerus, bukan lewat HTTP
# request. Deployment "autoscale" hanya bangun kalau ada trafik web masuk,
# yang tidak pernah terjadi untuk bot seperti ini -- jadi bot tidak akan
# tetap online kalau dideploy pakai autoscale.
deploymentTarget = "gce"
run = ["python3.11", "bot.py"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3.11 bot.py"

[workflows.workflow.metadata]
outputType = "console"
