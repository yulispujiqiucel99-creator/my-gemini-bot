DISCORD_TOKEN=
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.5-9b
# Contoh model lain (gunakan hanya jika tersedia di OpenRouter):
# AI_MODEL=qwen/qwen3-30b-a3b:free

# Buat fitur web search (/searching, atau kata pemicu di chat biasa).
# Daftar gratis di tavily.com (1.000 pencarian/bulan, tanpa kartu kredit).
TAVILY_API_KEY=
OPENROUTER_API_KEY_2=

# Opsional: PostgreSQL untuk memory permanen. Jika kosong, bot memakai
# data/permanent_memory.json sebagai fallback lokal.
DATABASE_URL=
# Jika memakai Railway Volume yang di-mount ke /app/data, gunakan path ini.
DATA_DIR=/app/data

# Opsional: Edge TTS gratis untuk command /tts. Tidak membutuhkan API key.
# Input dibuat singkat dan dibatasi konservatif agar audio sekitar <= 1,5 menit.
TTS_VOICE=id-ID-ArdiNeural
TTS_MAX_CHARS=800
# Batas teks mentah sebelum diringkas OpenRouter.
TTS_SOURCE_MAX_CHARS=12000
TTS_COOLDOWN_SECONDS=15
